{
  "name": "devconnect",
  "version": "1.0.0",
  "private": true,
  "description": "DevConnect — Developer Networking & Portfolio Platform (monorepo)",
  "workspaces": [
    "shared",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace shared && npm run build --workspace client",
    "build:shared": "npm run build --workspace shared",
    "build:client": "npm run build --workspace client",
    "lint": "npm run lint --workspace client",
    "typecheck": "npm run typecheck --workspace shared && npm run typecheck --workspace client",
    "test": "npm run test --workspace client",
    "test:e2e": "npm run test:e2e --workspace client",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
