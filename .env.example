# =============================================================================
# DevConnect — root environment example.  Copy to .env and fill real values.
# NEVER COMMIT REAL KEYS.
# =============================================================================

# ---- App ----
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
PORT=5000

# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key   # SERVER ONLY — never expose
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_STORAGE_BUCKET_PROJECTS=project-images
SUPABASE_STORAGE_BUCKET_BLOG=blog-images

# ---- OpenRouter (FREE MODELS ONLY) ----
OPENROUTER_API_KEY=sk-or-v1-...your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_CODE_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
OPENROUTER_REASONING_MODEL=deepseek/deepseek-r1:free
OPENROUTER_GUARD_MODEL=meta-llama/llama-guard-3-8b
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_X_TITLE=DevConnect

# ---- GitHub OAuth ----
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=https://YOUR-PROJECT.supabase.co/auth/v1/callback

# ---- Email (optional) ----
RESEND_API_KEY=re_...your-key

# ---- Rate limiting ----
AI_USER_HOURLY_LIMIT=20
API_RATE_WINDOW_MS=60000
API_RATE_MAX=120
MAX_UPLOAD_BYTES=2097152

# ---- Client (Vite: must be prefixed VITE_) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
VITE_API_URL=http://localhost:5000
VITE_APP_URL=http://localhost:5173
